local targetTool = nil

local function findSecondTool()
    task.spawn(function()
        while not targetTool do
            pcall(function()
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local char = LocalPlayer.Character
                if backpack then
                    local tools = {}
                    for _, v in ipairs(backpack:GetChildren()) do
                        if v:IsA("Tool") then
                            table.insert(tools, v)
                        end
                    end
                    if char then
                        for _, v in ipairs(char:GetChildren()) do
                            if v:IsA("Tool") then
                                table.insert(tools, v)
                            end
                        end
                    end
                    
                    if #tools >= 2 then
                        targetTool = tools[2]
                    end
                end
            end)
            task.wait(0.5)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    targetTool = nil
    findSecondTool()
end)

findSecondTool()

task.spawn(function()
    while true do
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            
            if char and humanoid and backpack and targetTool and targetTool.Parent then
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("Tool") and v ~= targetTool then
                        v.Parent = backpack
                    end
                end
                
                if targetTool.Parent ~= char then
                    humanoid:EquipTool(targetTool)
                end
                
                targetTool:Activate()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(500, 500))
            end
        end)
        task.wait(1)
    end
end)

