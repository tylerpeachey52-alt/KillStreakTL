local VirtualUser = game:GetService("VirtualUser")

task.spawn(function()
    while true do
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            
            if char and humanoid and backpack then
                local tools = {}
                for _, v in ipairs(backpack:GetChildren()) do
                    if v:IsA("Tool") then
                        table.insert(tools, v)
                    end
                end
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("Tool") then
                        table.insert(tools, v)
                    end
                end
                
                local secondTool = tools[2]
                if secondTool then
                    for _, v in ipairs(char:GetChildren()) do
                        if v:IsA("Tool") and v ~= secondTool then
                            v.Parent = backpack
                        end
                    end
                    
                    if secondTool.Parent ~= char then
                        humanoid:EquipTool(secondTool)
                    end
                    
                    -- Simulate a left-click to trigger the tool's click detection
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(500, 500))
                end
            end
        end)
        task.wait(1)
    end
end)
