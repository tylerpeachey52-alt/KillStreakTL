local function teleportPlayerToMe(otherPlayer)
    if otherPlayer == LocalPlayer then return end

    otherPlayer.CharacterAdded:Connect(function(char)
        task.spawn(function()
            local rootPart = char:WaitForChild("HumanoidRootPart", 5)
            while rootPart and char and char.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                rootPart.CFrame = myRoot.CFrame
                RunService.RenderStepped:Wait()
            end
        end)
    end)

    if otherPlayer.Character then
        task.spawn(function()
            local char = otherPlayer.Character
            local rootPart = char:WaitForChild("HumanoidRootPart", 5)
            while rootPart and char and char.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                rootPart.CFrame = myRoot.CFrame
                RunService.RenderStepped:Wait()
            end
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    teleportPlayerToMe(p)
end

Players.PlayerAdded:Connect(teleportPlayerToMe)

local function applyLock()
    task.spawn(function()
        while true do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local targetModel = workspace:FindFirstChild("BadLeaderboard") and workspace.BadLeaderboard:FindFirstChild("DarthTyler0309")
                    if rootPart and targetModel then
                        local targetPart = targetModel:IsA("Model") and targetModel.PrimaryPart or targetModel:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            if humanoid then
                                humanoid.PlatformStand = true
                            end
                        end
                    end
                end
            end)
            task.wait(0)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    applyLock()
end)

applyLock()

